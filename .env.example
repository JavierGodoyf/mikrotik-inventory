# Copia a .env y ajusta si hace falta.

# El archivo .env se busca en el directorio de trabajo, o donde apunte
# MTIK_BASE_DIR (útil cuando el paquete se instala fuera del repo).

# Base de datos SQLite (ruta absoluta o relativa al proyecto)
# MTIK_DB_URL=sqlite:////Users/javierg/mikrotik-inventory/data/devices.db

# Clave Fernet con la que se cifran las contraseñas de los routers.
# Si no existe, se genera sola en data/secret.key (chmod 600).
# MTIK_KEY_FILE=/Users/javierg/mikrotik-inventory/data/secret.key

# Cada cuántas horas se comprueban todos los equipos
MTIK_CHECK_INTERVAL_HOURS=6

# Timeouts de conexión (segundos)
MTIK_LAN_TIMEOUT=8
MTIK_PUBLIC_TIMEOUT=15

# Caché de las versiones publicadas por MikroTik (horas)
MTIK_UPSTREAM_CACHE_HOURS=6

# Equipos comprobados en paralelo
MTIK_MAX_CONCURRENCY=8

# Scheduler automático
MTIK_SCHEDULER_ENABLED=true

# Servidor: por seguridad, solo escucha en localhost
MTIK_HOST=127.0.0.1
MTIK_PORT=8000
