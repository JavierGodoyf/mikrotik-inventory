# Copia a .env y ajusta si hace falta.

# El archivo .env se busca en el directorio de trabajo, o donde apunte
# MTIK_BASE_DIR (útil cuando el paquete se instala fuera del repo).

# Base de datos SQLite (ruta absoluta o relativa al proyecto)
# MTIK_DB_URL=sqlite:////Users/javierg/mikrotik-inventory/data/devices.db

# Clave Fernet con la que se cifran las contraseñas de los routers.
# Si no existe, se genera sola en data/secret.key (chmod 600).
# MTIK_KEY_FILE=/Users/javierg/mikrotik-inventory/data/secret.key

# Cada cuántas horas se comprueban todos los equipos
MTIK_CHECK_INTERVAL_HOURS=6

# Timeouts de conexión (segundos)
MTIK_LAN_TIMEOUT=8
MTIK_PUBLIC_TIMEOUT=15

# Caché de las versiones publicadas por MikroTik (horas)
MTIK_UPSTREAM_CACHE_HOURS=6

# Equipos comprobados en paralelo
MTIK_MAX_CONCURRENCY=8

# Scheduler automático
MTIK_SCHEDULER_ENABLED=true

# Servidor: por seguridad, solo escucha en localhost
MTIK_HOST=127.0.0.1
MTIK_PORT=8000

# ---------------------------------------------------------------- WatchGuard (opcional)
# La sección /watchguard aparece al rellenar las credenciales o con WG_DEMO=1.
# Datos de WatchGuard Cloud > Administración > Managed Access (Access ID de solo lectura).
# WG_BASE_URL=https://api.eu.cloud.watchguard.com
# WG_AUTH_URL=https://api.eu.cloud.watchguard.com/oauth/token
# WG_ACCOUNT_ID=WGC-1-xxxxxxxxxxxx
# WG_ACCESS_ID=
# WG_PASSWORD=
# WG_API_KEY=

# Equipos de ejemplo sin llamar a la API (los avisos de seguridad sí son reales)
# WG_DEMO=1

# Última versión de Fireware por rama; vacío = se obtiene de psirt.watchguard.com
# WG_LATEST_FIREWARE=2026.4,12.12.4,12.5.22
# Gravedad a partir de la cual un Firebox se marca como crítico: critical o high
# WG_ALERT_SEVERITY=critical
# WG_PSIRT=0 desactiva la consulta de avisos; horas de caché de los avisos
# WG_PSIRT=1
# WG_PSIRT_CACHE_HOURS=6
# Cada cuántas horas se lee WatchGuard Cloud (por defecto, MTIK_CHECK_INTERVAL_HOURS)
# WG_CHECK_INTERVAL_HOURS=6
